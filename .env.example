# ─── Domaine ────────────────────────────────────────────────────────────────
# Domaine canonique du site, en production : AVEC « www », sans barre finale.
# C’est l’hôte que Vercel sert réellement ; webtreize.com y redirige en 308.
# En production, laisser vide ou mettre exactement cette valeur.
NEXT_PUBLIC_SITE_URL=https://www.webtreize.com

# ─── Coordonnées ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=contact@webtreize.com

# Téléphone professionnel, format international (« +33 6 12 34 56 78 »).
# Laisser vide tant qu’il n’existe pas : aucun composant ne l’affiche alors.
NEXT_PUBLIC_CONTACT_PHONE=

# Profils professionnels, uniquement s’ils sont réellement ouverts.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ─── Google Search Console ──────────────────────────────────────────────────
# Repli seulement. La méthode recommandée est l’enregistrement DNS TXT
# (propriété « Domaine »). Coller ici la valeur « content » de la balise HTML.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Mesure d’audience ──────────────────────────────────────────────────────
# Vide = aucune mesure : la politique de confidentialité le dit, et c’est vrai.
# « plausible » = mesure sans cookie via Plausible (exemptée de consentement
# selon les conditions de la CNIL). La politique de confidentialité bascule
# d’elle-même sur le texte correspondant : les deux ne peuvent pas diverger.
NEXT_PUBLIC_ANALYTICS=
# Domaine déclaré dans Plausible (par défaut : www.webtreize.com).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ─── Resend — envoi du formulaire de contact ────────────────────────────────
# Créer un compte, vérifier le domaine, générer une clé. Absente en production,
# la route /api/contact renvoie une erreur explicite plutôt que de perdre le
# message en silence.
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=WebTreize <contact@webtreize.com>
