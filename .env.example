# Domaine canonique du site, en production.
# Une seule forme dans tout le projet : sans « www », sans barre oblique finale.
# Toute autre variante (www, .fr) doit être redirigée en 308 chez l’hébergeur.
NEXT_PUBLIC_SITE_URL=https://webtreize.com

# Adresse de contact affichée sur le site et déclarée dans les données structurées.
NEXT_PUBLIC_CONTACT_EMAIL=contact@webtreize.com

# Resend — envoi du formulaire de contact.
# Créer un compte sur resend.com, vérifier le domaine, puis générer une clé API.
# Absente en production, la route /api/contact renvoie une erreur explicite
# plutôt que de perdre le message en silence.
RESEND_API_KEY=re_xxxxxxxxxxxx
